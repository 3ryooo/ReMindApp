### Swift ###
# Xcode
#
# gitignore寄稿者へ: Global/Xcode.gitignore、Objective-C.gitignore、Swift.gitignoreの更新を忘れずに

#==============================================================================
# システム・OS関連
#==============================================================================

## macOS固有のファイル
.DS_Store

#==============================================================================
# Xcode関連
#==============================================================================

## ユーザー設定
xcuserdata/
.xcuserstate

# チームでビルド設定（Scheme）を共有する場合は、この行をアンコメント
# xcshareddata/

## ワークスペース
# プロジェクトファイルとワークスペース設定を分ける場合に生成されるため、無視します
# （例: CocoaPodsを利用している場合など）
*.xcodeproj/project.xcworkspace
*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcworkspace/xcshareddata/

## ビルド・生成ファイル
build/
DerivedData/
.build/

## 互換性関連ファイル
# Xcode 8以前との互換性（Xcode 9以降では無視する必要なし）
*.xcscmblueprint
*.xccheckout

# Xcode 3以前との互換性（Xcode 4以降では無視する必要なし）
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Swift/Objective-C固有
*.hmap

## アプリパッケージング
*.xcarchive

#==============================================================================
# 署名 / 認証情報 (Signing / credentials)
#==============================================================================
# 証明書や秘密鍵などの機密情報
*.p12
*.mobileprovision
*.cer
*.pem
*.p8
*.key
*.keystore

#==============================================================================
# 機密情報 (Secrets)
#==============================================================================
# APIキーや環境変数ファイルなど
Secrets/
Secrets/*
.env.*

# Firebaseなど外部サービスの設定ファイル
GoogleService-Info.plist
google-service-info.plist
*.ipa
*.dSYM.zip
*.dSYM

## Xcode Playgrounds
timeline.xctimeline
playground.xcworkspace

#==============================================================================
# 依存関係管理
#==============================================================================

## Swift Package Manager
# Swift Package Managerの依存関係からソースコードをチェックインしたくない場合はこの行を追加
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
# Xcodeは.xcworkspacedataファイルとxcuserdataを含むこのディレクトリを自動生成するため
# プロジェクトにパッケージ設定ファイルを追加していない限り不要
# .swiftpm

## CocoaPods
# Podsディレクトリを.gitignoreに追加することは推奨しません。ただし、
# 自分で判断してください。長所と短所については以下で説明されています:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
# Pods/
# Xcodeワークスペースからソースコードをチェックインしたくない場合はこの行を追加
# *.xcworkspace

## Carthage
# Carthageの依存関係からソースコードをチェックインしたくない場合はこの行を追加
# Carthage/Checkouts
Carthage/Build/

## Accio依存関係管理
Dependencies/
.accio/

#==============================================================================
# ビルド・デプロイツール
#==============================================================================

## fastlane
# スクリーンショットをgitリポジトリに保存することは推奨されません。
# 代わりに、必要な時にfastlaneを使用してスクリーンショットを再生成してください。
# 推奨セットアップの詳細については以下を参照:
# https://docs.fastlane.tools/best-practices/source-control/#source-control
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## コードインジェクション
# 新しいコードインジェクションツール後、生成されたフォルダ /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode
iOSInjectionProject/

#==============================================================================
# データ・モデルファイル
#==============================================================================

## 機械学習モデル
*.mlmodel

## データベース（Realm）
*.realm
*.realm.lock
*.realm.management/

#==============================================================================
# 設定・秘密情報
#==============================================================================

## 基本的な秘密情報
Secrets.plist
*.env
*.xcconfig

## クラウドサービス設定
# Google Services（例: GoogleService-Info.plist）
GoogleService-Info.plist

# AWS設定
awsconfiguration.json
amplifyconfiguration.json

# Firebase設定
firebase_app_id_file.json

## プロパティリスト内の機密コンテンツ
**/Configuration/*.plist
**/Private/*.plist

#==============================================================================
# 個人・開発用ファイル
#==============================================================================

## 個人メモ・一時ファイル
Memo
.specstory
.cursorindexingignore

